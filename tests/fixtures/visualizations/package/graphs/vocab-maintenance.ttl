# A second vocabulary for testing bin/question_visualizations.py: maintenance of technical assets - two class
# trees meeting in one question (Asset, Organization), a membership and a part-whole hierarchy, three relations
# between the same two classes, and a relation from the top of a tree into its own subtree (located in).
@prefix ex: <https://example.com/complex/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix gist: <https://w3id.org/semanticarts/ns/ontology/gist/> .

ex:Asset a owl:Class ; rdfs:label "Asset"@en .
ex:Equipment a owl:Class ; rdfs:label "Equipment"@en ; rdfs:subClassOf ex:Asset .
ex:Pump a owl:Class ; rdfs:label "Pump"@en ; rdfs:subClassOf ex:Equipment .
ex:Motor a owl:Class ; rdfs:label "Motor"@en ; rdfs:subClassOf ex:Equipment .
ex:Facility a owl:Class ; rdfs:label "Facility"@en ; rdfs:subClassOf ex:Asset .
ex:Plant a owl:Class ; rdfs:label "Plant"@en ; rdfs:subClassOf ex:Facility .
ex:Site a owl:Class ; rdfs:label "Site"@en ; rdfs:subClassOf ex:Facility .
ex:Organization a owl:Class ; rdfs:label "Organization"@en .
ex:Contractor a owl:Class ; rdfs:label "Contractor"@en ; rdfs:subClassOf ex:Organization .
ex:Manufacturer a owl:Class ; rdfs:label "Manufacturer"@en ; rdfs:subClassOf ex:Organization .
ex:Person a owl:Class ; rdfs:label "Person"@en .
ex:Team a owl:Class ; rdfs:label "Team"@en .
ex:WorkOrder a owl:Class ; rdfs:label "Work order"@en .
ex:FailureMode a owl:Class ; rdfs:label "Failure mode"@en .
ex:Country a owl:Class ; rdfs:label "Country"@en .

ex:concerns a owl:ObjectProperty ; rdfs:label "concerns"@en ; rdfs:domain ex:WorkOrder ; rdfs:range ex:Equipment .
ex:assignee a owl:ObjectProperty ; rdfs:label "assignee"@en ; rdfs:domain ex:WorkOrder ; rdfs:range ex:Person .
ex:requester a owl:ObjectProperty ; rdfs:label "requester"@en ; rdfs:domain ex:WorkOrder ; rdfs:range ex:Person .
ex:approver a owl:ObjectProperty ; rdfs:label "approver"@en ; rdfs:domain ex:WorkOrder ; rdfs:range ex:Person .
ex:addresses a owl:ObjectProperty ; rdfs:label "addresses"@en ; rdfs:domain ex:WorkOrder ; rdfs:range ex:FailureMode .
ex:locatedIn a owl:ObjectProperty ; rdfs:label "located in"@en ; rdfs:domain ex:Asset ; rdfs:range ex:Site .
ex:partOf a owl:ObjectProperty ; rdfs:label "part of"@en ; rdfs:domain ex:Equipment ; rdfs:range ex:Plant ;
    rdfs:seeAlso gist:isPartOf .
ex:operatedBy a owl:ObjectProperty ; rdfs:label "operated by"@en ; rdfs:domain ex:Facility ; rdfs:range ex:Organization .
ex:maintainedBy a owl:ObjectProperty ; rdfs:label "maintained by"@en ; rdfs:domain ex:Equipment ; rdfs:range ex:Organization .
ex:madeBy a owl:ObjectProperty ; rdfs:label "made by"@en ; rdfs:domain ex:Equipment ; rdfs:range ex:Manufacturer .
ex:employs a owl:ObjectProperty ; rdfs:label "employs"@en ; rdfs:domain ex:Organization ; rdfs:range ex:Person .
ex:memberOf a owl:ObjectProperty ; rdfs:label "member of"@en ; rdfs:domain ex:Person ; rdfs:range ex:Team ;
    rdfs:seeAlso gist:isMemberOf .
ex:responsibleTeam a owl:ObjectProperty ; rdfs:label "responsible team"@en ; rdfs:domain ex:Site ; rdfs:range ex:Team .
ex:country a owl:ObjectProperty ; rdfs:label "country"@en ; rdfs:domain ex:Organization ; rdfs:range ex:Country .
ex:typicalFor a owl:ObjectProperty ; rdfs:label "typical for"@en ; rdfs:domain ex:FailureMode ; rdfs:range ex:Equipment .
ex:broaderMode a owl:ObjectProperty, owl:TransitiveProperty ; rdfs:label "broader mode"@en ;
    rdfs:domain ex:FailureMode ; rdfs:range ex:FailureMode .

ex:name a owl:DatatypeProperty ; rdfs:label "name"@en ; rdfs:domain ex:Asset ; rdfs:range xsd:string .
ex:serialNumber a owl:DatatypeProperty ; rdfs:label "serial number"@en ; rdfs:domain ex:Equipment ; rdfs:range xsd:string .
ex:ratedPower a owl:DatatypeProperty ; rdfs:label "rated power"@en ; rdfs:domain ex:Motor ; rdfs:range xsd:decimal .
ex:flowRate a owl:DatatypeProperty ; rdfs:label "flow rate"@en ; rdfs:domain ex:Pump ; rdfs:range xsd:decimal .
ex:dueDate a owl:DatatypeProperty ; rdfs:label "due date"@en ; rdfs:domain ex:WorkOrder ; rdfs:range xsd:date .
ex:openedOn a owl:DatatypeProperty ; rdfs:label "opened on"@en ; rdfs:domain ex:WorkOrder ; rdfs:range xsd:date .
ex:email a owl:DatatypeProperty ; rdfs:label "email"@en ; rdfs:domain ex:Person ; rdfs:range xsd:string .
