{
    "permissions": {
        "allow": [
            "Bash(task build)",
            "Bash(task check)",
            "Bash(task check:offline)",
            "Bash(task clean)",
            "Bash(gh issue list:*)",
            "Bash(gh search issues:*)"
        ]
    },
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Edit|Write|NotebookEdit|Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/skill-check.py",
                        "timeout": 10
                    }
                ]
            }
        ],
        "Stop": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/template-feedback.py",
                        "timeout": 30
                    },
                    {
                        "type": "command",
                        "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/skill-check.py",
                        "timeout": 30
                    }
                ]
            }
        ]
    }
}
